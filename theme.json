		},
		"css": ".wp-block-navigation .wp-block-navigation-item a {\n   padding: .5rem 2.5rem;\n   border: 1px solid transparent;\n}\n\n.wp-block-navigation .wp-block-navigation-item a:hover {\n   border: 1px solid #6c757d;\n   border-radius: .375rem;\n   text-decoration: none;\n}\n\n.page-title, .section-title {\n   font-size: 3rem;\n   color: var(--wp--preset--color--primary-500);\n}\n\n.page.lead.subhd, .page.lead.subhd2, .page.subhd, .page.subhd2 {\n    font-size: 1.5rem;\n    font-family: Lato;\n    font-weight: 700;\n    text-transform: uppercase;\n    color: 495057;\n    margin-bottom: .75rem;\n}",
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--base)",
					"text": "var(--wp--preset--color--accent-500)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lato)",
					"fontSize": "1.5rem",
					"fontWeight": "400",
					"textAlign": "center",
					"textTransform": "uppercase"
				}
			},
			"caption": {
